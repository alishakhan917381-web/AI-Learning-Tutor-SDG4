# ========================================================
# CampusBot AI - Environment Configuration
# ========================================================

# Google Gemini API Key
# 1. Go to https://aistudio.google.com/
# 2. Click "Create API Key"
# 3. Copy and paste your key below
# 4. Save this file as .env (without the .example suffix)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
# Recommended: gemini-2.5-flash (fast, state-of-the-art) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Flask Server Port (Default: 5000)
PORT=5000
